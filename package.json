{
	"name": "obsidian-draw",
	"version": "1.0.1",
	"description": "ObsidianDraw - Seamless Excalidraw integration for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"overrides": {
